# .env.example
# Personal AI Intelligence Agent Configuration

# Supabase Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Gemini AI API Configuration
# Required for semantic relevance classification and grounded summarization
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Discord Notification Configuration
# Use Webhook for alert/digest delivery (recommended for MVP)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"
# Optional Bot token for interactive slash commands (post-MVP)
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CHANNEL_ID="your-discord-channel-id"

# Collector & Ingestion Configuration
COLLECTION_INTERVAL_MINUTES=60
MAX_ARTICLES_PER_RUN=50
MAX_AI_CALLS_PER_RUN=30
HTTP_REQUEST_TIMEOUT_SECONDS=15
USER_AGENT="Mozilla/5.0 (compatible; PersonalIntelligenceAgent/1.0; +https://github.com/user/ai-intelligence-agent)"

# User Preference Defaults (VTU 2025 Scheme)
USER_SCHEME="2025"
USER_BRANCH="CSE"
USER_SEMESTER="1"

# Environment & Logging
APP_ENV="development" # development | production | test
LOG_LEVEL="INFO"
